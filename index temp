        }

        /* CV Layout Grid */
        .cv-layout {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 1.25rem;
            margin-bottom: 2rem;
        }

.cv-doc-container {
    width: 100%;
    /* Gives it a proper height for desktop */
    height: 600px; 
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: #1e293b;
    display: flex;
    justify-content: center;
    align-items: center;
}

.cv-img {
    width: 100%;
    height: 100%;
    /* Forces the entire document page to scale down and fit inside without zooming/clipping */
    object-fit: contain; 
}

        .cv-highlights {
