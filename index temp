<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Juergen Law Laturisa | Personal Website</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧬</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0f1622;
            --card-bg: #131a26;
            --border-color: #222f47;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --accent-blue: #38bdf8;
            --accent-green: #34d399;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        @media (hover: hover) and (pointer: fine) {
            body, a, button, label, input, .account-button, .sub-link-card, .nav-card {
                cursor: none !important;
            }

            .cursor-brackets, .cursor-dot {
                position: fixed;
                top: 0;
                left: 0;
                pointer-events: none;
                transform: translate(-50%, -50%);
                color: var(--accent-blue);
                font-weight: bold;
                font-family: 'JetBrains Mono', monospace;
                user-select: none;
                z-index: 9999;
                text-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
            }

            .cursor-dot {
                font-size: 24px;
                line-height: 1;
            }

            .cursor-brackets {
                font-size: 28px;
                line-height: 1;
                display: flex;
                gap: 12px;
                transition: gap 0.3s cubic-bezier(0.25, 1, 0.5, 1), transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
            }

            .cursor-brackets.hovered {
                gap: 32px;
                transform: translate(-50%, -50%) scale(1.15);
            }

            .hover-preview {
                position: fixed;
                top: 0;
                left: 0;
                width: 220px;
                height: 125px;
                border-radius: 8px;
                overflow: hidden;
                border: 1px solid var(--accent-green);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6), 0 0 15px rgba(52, 211, 153, 0.25);
                pointer-events: none;
                z-index: 9998;
                opacity: 0;
                visibility: hidden;
                transform: translate(-50%, -125%) scale(0.85);
                transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.25s ease;
                background: var(--card-bg);
            }

            .hover-preview.active {
                opacity: 1;
                visibility: visible;
                transform: translate(-50%, -125%) scale(1);
            }

            .hover-preview img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
        }

        @media (hover: none), (pointer: coarse) {
            .cursor-brackets, .cursor-dot, .hover-preview {
                display: none !important;
            }
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 2rem 1rem;
            background-image: 
                radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(56, 189, 248, 0.12), transparent 40%),
                linear-gradient(135deg, rgba(56, 189, 248, 0.08) 25%, transparent 25%, transparent 50%, rgba(56, 189, 248, 0.08) 50%, rgba(56, 189, 248, 0.08) 75%, transparent 75%, transparent),
                linear-gradient(180deg, #0b0f17 0%, #111a2e 50%, #0b0f17 100%);
            background-size: 100% 100%, 160px 160px, 100% 100%;
            background-attachment: fixed;
            animation: backgroundCycle 25s linear infinite;
        }

        @keyframes backgroundCycle {
            0% { background-position: center, 0px 0px, center; }
            100% { background-position: center, 160px 160px, center; }
        }

        .container {
            width: 100%;
            max-width: 540px;
            background: rgba(19, 26, 38, 0.95);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 2.5rem 2rem;
            backdrop-filter: blur(8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            position: relative;
            overflow: hidden;
        }

        .view {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .view.active-view {
            display: block;
            opacity: 1;
        }

        .profile { text-align: center; margin-bottom: 1.5rem; }

        .avatar-container {
            position: relative;
            width: 150px;
            height: 150px;
            margin: 0 auto 1.5rem;
        }

        .avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border-color);
            background: #1e293b;
        }

        .avatar-container::before, .avatar-container::after {
            content: '';
            position: absolute;
            border: 1px solid var(--accent-blue);
            width: 12px;
            height: 12px;
            transition: all 0.3s ease;
        }
        .avatar-container::before { top: -4px; left: -4px; border-right: none; border-bottom: none; }
        .avatar-container::after { bottom: -4px; right: -4px; border-left: none; border-top: none; }

        .name {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.025em;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .tagline {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            color: var(--accent-blue);
            margin-bottom: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .bio-container {
            text-align: left;
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border-color);
        }

        .bio-heading {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--accent-blue);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }

        .bio {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.6;
            text-align: justify;         
            hyphens: auto;             
            word-break: break-word;
        }

        .links-container {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .section-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-top: 0.5rem;
            margin-bottom: 0.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            white-space: nowrap;
        }

        .section-label::before,
        .section-label::after {
            content: '';
            width: 30px;
            height: 1px;
            background: var(--border-color);
        }

        .grid-sub-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            line-height: 1;
            text-transform: uppercase;
            margin-top: 0.2rem;
        }

        .nav-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.25rem;
            background: rgba(30, 41, 59, 0.4);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            text-decoration: none;
            color: var(--text-primary);
            user-select: none;
            transition: all 0.2s ease;
        }

        .nav-card:hover {
            background: rgba(56, 189, 248, 0.06);
            border-color: var(--accent-blue);
        }

        .highlight-card { border-color: rgba(52, 211, 153, 0.3); }
        .highlight-card:hover {
            border-color: var(--accent-green);
            background: rgba(52, 211, 153, 0.06);
        }

        .back-nav {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--accent-blue);
            text-decoration: none;
            margin-bottom: 1.5rem;
            transition: transform 0.2s ease;
        }
        .back-nav:hover {
            transform: translateX(-4px);
        }

        .page-header {
            margin-bottom: 1.25rem;
        }
        .page-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .page-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-family: 'JetBrains Mono', monospace;
        }

        .sub-link-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            background: rgba(19, 26, 38, 0.6);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            text-decoration: none;
            color: var(--text-primary);
            transition: all 0.2s ease;
            margin-bottom: 0.5rem;
        }

        .sub-link-card:hover {
            border-color: var(--text-secondary);
            background: rgba(30, 41, 59, 0.6);
        }

        .link-info {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            max-width: 85%;
        }

        .link-title { font-size: 0.95rem; font-weight: 500; }
        .sub-link-title {
            font-size: 0.88rem;
            font-family: 'JetBrains Mono', monospace;
            line-height: 1.4;
        }

        .link-desc {
            font-size: 0.8rem;
            color: var(--text-secondary);
            line-height: 1.3;
        }

        .link-arrow {
            font-family: 'JetBrains Mono', monospace;
            color: var(--text-secondary);
            font-size: 1rem;
            transition: transform 0.2s ease;
            flex-shrink: 0;
            margin-left: 0.5rem;
        }

        .nav-card:hover .link-arrow, .sub-link-card:hover .link-arrow {
            color: var(--accent-blue);
            transform: translateX(4px);
        }
        
        .highlight-card:hover .link-arrow { color: var(--accent-green); }

        .accounts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(115px, 1fr));
            gap: 0.6rem;
            margin-top: 0.25rem;
            margin-bottom: 0.35rem;
        }

        .account-button {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 0.5rem;
            padding: 0.65rem 0.75rem;
            background: transparent;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-secondary);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .account-button img,
        .account-button svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        .account-button img {
            filter: invert(71%) sepia(13%) saturate(543%) hue-rotate(176deg) brightness(89%) contrast(89%);
        }

        .account-button svg { fill: var(--text-secondary); }

        .account-button:hover {
            color: var(--text-primary);
            border-color: var(--accent-blue);
            background: rgba(56, 189, 248, 0.03);
        }

        .account-button:hover img {
            filter: invert(68%) sepia(84%) saturate(1915%) hue-rotate(174deg) brightness(101%) contrast(98%);
        }

        .account-button:hover svg { fill: var(--accent-blue); }

        .eng-grid .account-button:hover {
            border-color: var(--accent-green);
            background: rgba(52, 211, 153, 0.03);
        }
        .eng-grid .account-button:hover img {
            filter: invert(70%) sepia(91%) saturate(362%) hue-rotate(106deg) brightness(93%) contrast(89%);
        }

        @media (max-width: 600px) {
            .container { padding: 2rem 1.25rem; }
            .name { font-size: 1.3rem; }
            .tagline { font-size: 0.78rem; }
            .accounts-grid {
                grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
                gap: 0.5rem;
            }
            .account-button {
                padding: 0.55rem 0.65rem;
                font-size: 0.75rem;
            }
        }

        .container {
            width: 100%;
            max-width: 540px;
            transition: max-width 0.3s ease;
        }

        .container:has(#view-cv.active-view) {
            max-width: 900px;
        }

        .cv-layout {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 1.25rem;
            margin-bottom: 2rem;
        }

        .cv-doc-container {
            width: 100%;
            height: 600px; 
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            background: #1e293b;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .cv-img {
            width: 100%;
            height: 100%;
            object-fit: contain; 
        }

        .cv-highlights {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .highlight-box {
            padding: 1rem;
            background: rgba(30, 41, 59, 0.4);
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }

        .highlight-title {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--accent-blue);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .highlight-text {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .highlight-list {
            list-style: none;
            padding: 0;
            font-size: 0.82rem;
            color: var(--text-secondary);
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .highlight-list li::before {
            content: "• ";
            color: var(--accent-green);
            font-weight: bold;
        }

        .doc-external-link {
            display: inline-block;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--accent-green);
            text-decoration: none;
            margin-top: 0.25rem;
            transition: color 0.2s ease;
        }

        .doc-external-link:hover {
            color: var(--text-primary);
            text-decoration: underline;
        }

        .cv-alternative-section {
            margin-top: 1.5rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border-color);
        }

        .alt-links-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;
            margin-top: 0.75rem;
        }

        .alt-link-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            border-radius: 8px;
            color: var(--accent-green);
            border: 1px solid rgba(52, 211, 153, 0.3);
            background: rgba(52, 211, 153, 0.05);
            text-decoration: none;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            transition: all 0.2s ease;
        }

        .alt-link-card:hover {
            border-color: var(--accent-green);
            background: rgba(52, 211, 153, 0.12);
            color: var(--accent-green);
            transform: translateY(-2px);
        }

        .alt-link-title {
            font-family: 'JetBrains Mono', monospace;
        }

        .alt-link-icon {
            font-family: 'JetBrains Mono', monospace;
            color: var(--text-secondary);
        }

        @media (max-width: 768px) {
            .cv-layout {
                grid-template-columns: 1fr;
            }

            .cv-doc-container {
                height: 380px;
            }

            .alt-links-grid {
                grid-template-columns: 1fr;
            }
        }

        .pub-filters {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
            overflow-x: auto;
            padding-bottom: 0.25rem;
        }
        
        .pub-filter-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            transition: all 0.2s ease;
        }
        
        .pub-filter-btn.active, .pub-filter-btn:hover {
            color: var(--accent-blue);
            border-color: var(--accent-blue);
            background: rgba(56, 189, 248, 0.08);
        }
        
        .publications-list {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }
        
        .pub-card {
            background: rgba(19, 26, 38, 0.6);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }
        
        .featured-pub {
            border-color: rgba(56, 189, 248, 0.25);
        }
        
        .placeholder-pub {
            opacity: 0.7;
            border-style: dashed;
        }
        
        .pub-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .pub-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            text-transform: uppercase;
            font-weight: 500;
        }
        
        .preprint-badge {
            background: rgba(56, 189, 248, 0.15);
            color: var(--accent-blue);
            border: 1px solid rgba(56, 189, 248, 0.3);
        }
        
        .review-badge {
            background: rgba(52, 211, 153, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(52, 211, 153, 0.3);
        }
        
        .pub-year {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-secondary);
        }
        
        .pub-title {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-primary);
            line-height: 1.35;
        }
        
        .pub-authors {
            font-size: 0.82rem;
            color: var(--text-secondary);
        }
        
        .pub-authors strong {
            color: var(--accent-blue);
        }
        
        .pub-abstract {
            font-size: 0.82rem;
            color: var(--text-secondary);
            line-height: 1.5;
        }
        
        .pub-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.4rem;
            padding-top: 0.6rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.78rem;
            font-family: 'JetBrains Mono', monospace;
        }
        
        .pub-doi-link {
            color: var(--accent-green);
            text-decoration: none;
            padding: 0.2rem 0.4rem;
            border-radius: 4px;
            background: rgba(52, 211, 153, 0.06);
            border: 1px solid rgba(52, 211, 153, 0.2);
            transition: all 0.2s ease;
        }
        
        .pub-doi-link:hover {
            background: rgba(52, 211, 153, 0.15);
            border-color: var(--accent-green);
            color: var(--accent-green);
        }
        
        .pub-venue {
            color: var(--text-secondary);
        }

      /* ================= SHOWCASE PROJECTS ================= */
      .projects-list {
          display: flex;
          flex-direction: column;
          gap: 4rem;
          margin-top: 2rem;
      }
      
      .project-showcase {
          background: rgba(13, 17, 23, 0.7);
          border: 1px solid rgba(0, 255, 102, 0.2);
          border-radius: 8px;
          padding: 2rem;
          display: flex;
          flex-direction: column;
          gap: 1.5rem;
          transition: border-color 0.3s ease;
      }
      
      .project-showcase:hover {
          border-color: rgba(0, 255, 102, 0.4);
      }
      
      .project-header {
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          flex-wrap: wrap;
          gap: 1rem;
      }
      
      .project-type-badge {
          font-size: 0.75rem;
          font-family: var(--font-mono, monospace);
          text-transform: uppercase;
          color: #00ff66;
          letter-spacing: 1px;
      }
      
      .project-type-badge.health-badge {
          color: #00f0ff;
      }
      
      .project-name {
          font-size: 1.8rem;
          margin: 0.2rem 0;
          color: #ffffff;
      }
      
      .project-tagline {
          font-size: 0.95rem;
          color: #8b949e;
          margin: 0;
      }
      
      .project-links {
          display: flex;
          gap: 0.75rem;
      }
      
      .project-btn {
          padding: 0.5rem 1rem;
          font-size: 0.85rem;
          font-family: var(--font-mono, monospace);
          text-decoration: none;
          border-radius: 4px;
          transition: all 0.2s ease;
      }
      
      .primary-btn {
          background: #00ff66;
          color: #0d1117;
          font-weight: bold;
      }
      
      .primary-btn:hover {
          background: #33ff85;
          box-shadow: 0 0 10px rgba(0, 255, 102, 0.4);
      }
      
      .secondary-btn {
          border: 1px solid rgba(255, 255, 255, 0.2);
          color: #c9d1d9;
      }
      
      .secondary-btn:hover {
          border-color: #00ff66;
          color: #00ff66;
      }
      
      .project-preview-container {
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 6px;
          overflow: hidden;
          background: #090d13;
      }
      
      .browser-bar {
          background: #161b22;
          padding: 0.5rem 1rem;
          display: flex;
          align-items: center;
          gap: 0.5rem;
          border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }
      
      .dot {
          width: 10px;
          height: 10px;
          border-radius: 50%;
      }
      
      .dot.red { background: #ff5f56; }
      .dot.yellow { background: #ffbd2e; }
      .dot.green { background: #27c93f; }
      
      .browser-title {
          margin-left: auto;
          font-size: 0.75rem;
          font-family: var(--font-mono, monospace);
          color: #6e7681;
      }
      
      .project-img {
          width: 100%;
          height: auto;
          display: block;
          object-fit: cover;
      }
      
      .project-body {
          display: grid;
          grid-template-columns: 1.2fr 0.8fr;
          gap: 2rem;
          margin-top: 1rem;
      }
      
      @media (max-width: 768px) {
          .project-body {
              grid-template-columns: 1fr;
