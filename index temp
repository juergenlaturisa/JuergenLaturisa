            color: var(--text-secondary);
            line-height: 1.6;
            text-align: justify;         
            hyphens: auto;             
            word-break: break-word;
        }

        .links-container {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .section-label {
