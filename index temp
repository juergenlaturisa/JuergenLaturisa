    <style>
        :root {
            --bg-color: #0f1622;
            --card-bg: #131a26;
            --border-color: #222f47;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --accent-blue: #38bdf8;
            --accent-green: #34d399;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        @media (hover: hover) and (pointer: fine) {
            body, a, button, label, input, .account-button, .sub-link-card, .nav-card {
                cursor: none !important;
            }

            .cursor-brackets, .cursor-dot {
                position: fixed;
                top: 0;
                left: 0;
                pointer-events: none;
                transform: translate(-50%, -50%);
                color: var(--accent-blue);
                font-weight: bold;
                font-family: 'JetBrains Mono', monospace;
                user-select: none;
                z-index: 9999;
                text-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
            }

            .cursor-dot {
                font-size: 24px;
                line-height: 1;
            }

            .cursor-brackets {
                font-size: 28px;
                line-height: 1;
                display: flex;
                gap: 12px;
                transition: gap 0.3s cubic-bezier(0.25, 1, 0.5, 1), transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
            }

            .cursor-brackets.hovered {
                gap: 32px;
                transform: translate(-50%, -50%) scale(1.15);
            }

            .hover-preview {
                position: fixed;
                top: 0;
                left: 0;
                width: 220px;
                height: 125px;
                border-radius: 8px;
                overflow: hidden;
                border: 1px solid var(--accent-green);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6), 0 0 15px rgba(52, 211, 153, 0.25);
                pointer-events: none;
                z-index: 9998;
                opacity: 0;
                transform: translate(-50%, -125%) scale(0.85);
                transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
                background: var(--card-bg);
            }

            .hover-preview.active {
                opacity: 1;
                transform: translate(-50%, -125%) scale(1);
            }

            .hover-preview img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
        }

        @media (hover: none), (pointer: coarse) {
            .cursor-brackets, .cursor-dot, .hover-preview {
                display: none !important;
            }
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 2rem 1rem;
            background-image: 
                radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(56, 189, 248, 0.12), transparent 40%),
                linear-gradient(135deg, rgba(56, 189, 248, 0.08) 25%, transparent 25%, transparent 50%, rgba(56, 189, 248, 0.08) 50%, rgba(56, 189, 248, 0.08) 75%, transparent 75%, transparent),
                linear-gradient(180deg, #0b0f17 0%, #111a2e 50%, #0b0f17 100%);
            background-size: 100% 100%, 160px 160px, 100% 100%;
            background-attachment: fixed;
            animation: backgroundCycle 25s linear infinite;
        }

        @keyframes backgroundCycle {
            0% { background-position: center, 0px 0px, center; }
            100% { background-position: center, 160px 160px, center; }
        }

        .container {
            width: 100%;
            max-width: 540px;
            background: rgba(19, 26, 38, 0.95);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 2.5rem 2rem;
            backdrop-filter: blur(8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            position: relative;
            overflow: hidden;
        }

        /* View Switching Logic */
        .view {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .view.active-view {
            display: block;
            opacity: 1;
        }

        .profile { text-align: center; margin-bottom: 1.5rem; }

        .avatar-container {
            position: relative;
            width: 150px;
            height: 150px;
            margin: 0 auto 1.5rem;
        }

        .avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border-color);
            background: #1e293b;
        }

        .avatar-container::before, .avatar-container::after {
            content: '';
            position: absolute;
            border: 1px solid var(--accent-blue);
            width: 12px;
            height: 12px;
            transition: all 0.3s ease;
        }
        .avatar-container::before { top: -4px; left: -4px; border-right: none; border-bottom: none; }
        .avatar-container::after { bottom: -4px; right: -4px; border-left: none; border-top: none; }

        .name {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.025em;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
