            padding-top: 1.25rem;
            border-top: 1px solid var(--border-color);
        }

        .alt-links-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;
            margin-top: 0.75rem;
