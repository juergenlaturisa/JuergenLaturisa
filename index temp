      /* Dynamic Container sizing for wide content on CV page */
        .container {
            width: 100%;
            max-width: 540px; /* Default for home */
            transition: max-width 0.3s ease;
        }

        /* Expand container when CV view is active */
        .container:has(#view-cv.active-view) {
