    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const body = document.body;
            const brackets = document.getElementById('brackets');
            const dot = document.getElementById('dot');
            const previewEl = document.getElementById('hover-preview');
            const previewImg = document.getElementById('preview-img');

            let mouseX = window.innerWidth / 2;
            let mouseY = window.innerHeight / 2;

            let dotX = mouseX, dotY = mouseY;
            let bracketsX = mouseX, bracketsY = mouseY;
            let previewX = mouseX, previewY = mouseY;

            body.addEventListener("mousemove", (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;

                body.style.setProperty("--mouse-x", `${mouseX}px`);
                body.style.setProperty("--mouse-y", `${mouseY}px`);
            });

            function lerp(start, end, amt) {
                return (1 - amt) * start + amt * end;
            }

            function render() {
                dotX = lerp(dotX, mouseX, 0.22);
                dotY = lerp(dotY, mouseY, 0.22);
                dot.style.left = `${dotX}px`;
                dot.style.top = `${dotY}px`;

                bracketsX = lerp(bracketsX, mouseX, 0.09);
                bracketsY = lerp(bracketsY, mouseY, 0.09);
                brackets.style.left = `${bracketsX}px`;
                brackets.style.top = `${bracketsY}px`;

                previewX = lerp(previewX, mouseX, 0.12);
                previewY = lerp(previewY, mouseY, 0.12);
                previewEl.style.left = `${previewX}px`;
                previewEl.style.top = `${previewY}px`;

                requestAnimationFrame(render);
            }

            render();

            // Router implementation for Method 1
            function router() {
                const hash = window.location.hash.substring(1) || 'home';
                const views = document.querySelectorAll('.view');
                
                let targetView = document.getElementById(`view-${hash}`);
                if (!targetView) {
                    targetView = document.getElementById('view-home');
                }

                views.forEach(view => {
                    view.classList.remove('active-view');
                });

                targetView.classList.add('active-view');
                window.scrollTo(0, 0);
            }

            window.addEventListener('hashchange', router);
            router(); // Run on initial load

            document.addEventListener('mouseover', (e) => {
                if (e.target.closest('a, button, label, .account-button, .sub-link-card, .nav-card')) {
                    brackets.classList.add('hovered');
                }

                const previewTarget = e.target.closest('[data-preview]');
                if (previewTarget) {
                    const imgSrc = previewTarget.getAttribute('data-preview');
                    if (imgSrc) {
                        previewImg.src = imgSrc;
                        previewEl.classList.add('active');
                    }
                }
            });

            document.addEventListener('mouseout', (e) => {
                if (e.target.closest('a, button, label, .account-button, .sub-link-card, .nav-card')) {
                    brackets.classList.remove('hovered');
                }

                if (e.target.closest('[data-preview]')) {
                    previewEl.classList.remove('active');
                }
            });
        });

                 // --- PIE CHART GROUP HOVER LOGIC ---
            const pieGroups = document.querySelectorAll('.pie-group');
            const sliceLabel = document.getElementById('slice-label');
            
            pieGroups.forEach(group => {
                group.addEventListener('mouseenter', () => {
                    const name = group.getAttribute('data-name');
                    sliceLabel.textContent = `[ OPEN ${name.toUpperCase()} ↗ ]`;
                    sliceLabel.style.borderColor = '#00ff66';
                });
            
                group.addEventListener('mouseleave', () => {
                    sliceLabel.textContent = '// HOVER OR CLICK A SLICE';
                    sliceLabel.style.borderColor = 'rgba(0, 255, 102, 0.3)';
                });
            
                group.addEventListener('click', () => {
                    const link = group.getAttribute('data-link');
                    if (link) {
                        window.open(link, '_blank', 'noopener,noreferrer');
                    }
                });
            });
            
                  // --- PUBLICATION FILTER LOGIC ---
            const filterBtns = document.querySelectorAll('.pub-filter-btn');
            const pubCards = document.querySelectorAll('.pub-card');
            
            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // 1. Remove the green/blue active highlight from all buttons
                    filterBtns.forEach(b => b.classList.remove('active'));
                    // 2. Add the active highlight to the one we just clicked
                    btn.classList.add('active');
            
                    // 3. Get the filter category (e.g., 'all' or 'preprint')
                    const filterValue = btn.getAttribute('data-filter');
            
                    // 4. Show or hide the cards based on the category
                    pubCards.forEach(card => {
                        if (filterValue === 'all' || card.getAttribute('data-category') === filterValue) {
                            card.style.display = 'flex'; // Keep your flexbox layout
                        } else {
                            card.style.display = 'none'; // Hide it
                        }
                    });
                });
            });

        function copyEmail() {
            const email = "juergenllaturisa@gmail.com";
            navigator.clipboard.writeText(email).then(() => {
                const btnText = document.getElementById("email-text");
                const originalText = btnText.innerText;
                btnText.innerText = "Copied!";
                btnText.style.color = "var(--accent-blue)";
                
                setTimeout(() => {
                    btnText.innerText = originalText;
                    btnText.style.color = "";
                }, 2000);
            }).catch(() => {
                window.location.href = "mailto:" + email;
            });
        }
    </script>
</body>
</html>
